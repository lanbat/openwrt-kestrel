#!/bin/sh /etc/rc.common

START=97
USE_PROCD=1

start_service() {
    config_load sf-ircd
    config_get_bool enabled main enabled 0
    [ "$enabled" = 1 ] || return 0
    [ -x /usr/bin/sf ] || return 0

    config_get listen_addr main listen_addr
    config_get server_name main server_name kestrel.local
    config_get db main db /etc/kestrel/social-firewall/social-firewall.sqlite
    config_get out_dir main out_dir /etc/kestrel/social-firewall/chat-out
    config_get firewall_zone main firewall_zone lan
    config_get tls_cert main tls_cert /etc/uhttpd.crt
    config_get tls_key main tls_key /etc/uhttpd.key
    config_get oidc_introspection_url main oidc_introspection_url
    config_get oidc_client_id main oidc_client_id
    config_get oidc_client_secret_file main oidc_client_secret_file
    config_get oidc_ca_file main oidc_ca_file
    config_get oidc_issuer main oidc_issuer
    config_get oidc_audience main oidc_audience
    config_get oidc_required_group main oidc_required_group
    config_get oidc_write_entitlement main oidc_write_entitlement
    config_get oidc_operator_entitlement main oidc_operator_entitlement
    [ -n "$listen_addr" ] || return 0
    case "$listen_addr" in
        0.0.0.0:*|\[::\]:*|::* )
        logger -t sf-ircd "refusing wildcard IRC listen address: $listen_addr"
            return 0
            ;;
    esac
    port="${listen_addr##*:}"
    case "$port" in
        ''|*[!0-9]*)
            logger -t sf-ircd "refusing IRC address without a numeric port: $listen_addr"
            return 0
            ;;
    esac
    [ -r "$tls_cert" ] || {
        logger -t sf-ircd "TLS certificate is not readable: $tls_cert"
        return 0
    }
    [ -r "$tls_key" ] || {
        logger -t sf-ircd "TLS private key is not readable: $tls_key"
        return 0
    }
    if [ -n "$oidc_introspection_url$oidc_client_id$oidc_client_secret_file" ]; then
        [ -n "$oidc_introspection_url" ] && [ -n "$oidc_client_id" ] && [ -n "$oidc_client_secret_file" ] && [ -r "$oidc_client_secret_file" ] || {
            logger -t sf-ircd "incomplete or unreadable Authentik OIDC configuration"
            return 0
        }
    fi

    uci -q delete firewall.sf_ircd 2>/dev/null || true
    uci set firewall.sf_ircd=rule
    uci set firewall.sf_ircd.name='Allow-SF-IRCd-LAN'
    uci set firewall.sf_ircd.src="$firewall_zone"
    uci set firewall.sf_ircd.proto='tcp'
    uci set firewall.sf_ircd.dest_port="$port"
    uci set firewall.sf_ircd.target='ACCEPT'
    uci commit firewall
    fw4 reload 2>/dev/null || true

    procd_open_instance
    procd_set_param command /usr/bin/sf --db "$db" ircd \
        --listen "$listen_addr" --server-name "$server_name" --out-dir "$out_dir" \
        --tls-cert "$tls_cert" --tls-key "$tls_key"
    if [ -n "$oidc_introspection_url" ]; then
        procd_append_param command --oidc-introspection-url "$oidc_introspection_url" \
            --oidc-client-id "$oidc_client_id" \
            --oidc-client-secret-file "$oidc_client_secret_file"
        [ -n "$oidc_ca_file" ] && procd_append_param command --oidc-ca-file "$oidc_ca_file"
        [ -n "$oidc_issuer" ] && procd_append_param command --oidc-issuer "$oidc_issuer"
        [ -n "$oidc_audience" ] && procd_append_param command --oidc-audience "$oidc_audience"
        [ -n "$oidc_required_group" ] && procd_append_param command --oidc-required-group "$oidc_required_group"
        [ -n "$oidc_write_entitlement" ] && procd_append_param command --oidc-write-entitlement "$oidc_write_entitlement"
        [ -n "$oidc_operator_entitlement" ] && procd_append_param command --oidc-operator-entitlement "$oidc_operator_entitlement"
    fi
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param respawn 3600 5 5
    procd_set_param file /etc/config/sf-ircd
    procd_close_instance
}

stop_service() {
    uci -q delete firewall.sf_ircd 2>/dev/null || true
    uci commit firewall
    fw4 reload 2>/dev/null || true
}
