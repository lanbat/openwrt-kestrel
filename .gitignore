configs/*.conf

# Local `make package`/`cross install` build output (target/pkg/*.apk,
# *.ipk, staging dirs) — regenerated by `make build`/`make package`.
/target/

# test/qemu/ working state: downloaded base images, disk copies, QEMU
# pid/monitor/serial files, and the build/deploy staging tarball. None of
# this should ever be committed — test/qemu/setup.sh regenerates it.
test/qemu/work/
